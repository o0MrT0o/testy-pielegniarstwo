from pathlib import Path
import re

root=Path(".")
app=root/"app/src/main/assets/www/app.js"
txt=app.read_text()

# state/session additions
txt=txt.replace(
" flashSchedule:{},questionStats:{},quizHistory:[],todayDate:'',todayMinutes:0\n};",
" flashSchedule:{},questionStats:{},quizHistory:[],todayDate:'',todayMinutes:0,lastStudyDate:'',dailyPlansCompleted:0\n};"
)
txt=txt.replace(
"let route={name:'dashboard'};\nlet deferredInstall=null;\nlet quizSession=null;\nlet flashSession=null;",
"let route={name:'dashboard'};\nlet navStack=[];\nlet deferredInstall=null;\nlet quizSession=null;\nlet flashSession=null;\nlet dailyPlanSession=null;"
)

def replace_between(text,start_marker,end_marker,replacement):
    s=text.index(start_marker)
    e=text.index(end_marker,s)
    return text[:s]+replacement+text[e:]

NEW_HELPERS='function localDay(){\n const d=new Date();\n return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,\'0\')}-${String(d.getDate()).padStart(2,\'0\')}`;\n}\nfunction dayNumber(value){\n if(!value)return null;\n const [y,m,d]=value.split(\'-\').map(Number);\n return Math.floor(Date.UTC(y,m-1,d)/86400000);\n}\nfunction ensureToday(){\n const t=localDay();\n if(state.todayDate!==t){state.todayDate=t;state.todayMinutes=0}\n}\nfunction recordStudyDay(){\n const today=localDay();\n if(state.lastStudyDate===today)return;\n const prev=dayNumber(state.lastStudyDate),now=dayNumber(today);\n state.streak=prev!==null&&now-prev===1?Math.max(1,state.streak||0)+1:1;\n state.lastStudyDate=today;\n}\nensureToday();\n\nfunction save(){localStorage.setItem(\'nursestudy-state\',JSON.stringify(state));}\nfunction toast(msg){const t=document.querySelector(\'#toast\');t.textContent=msg;t.classList.add(\'show\');clearTimeout(toast._t);toast._t=setTimeout(()=>t.classList.remove(\'show\'),2600)}\nfunction setTheme(theme){state.theme=theme;document.documentElement.dataset.theme=theme;document.querySelector(\'#theme-btn\').textContent=theme===\'dark\'?\'☀\':\'☾\';save()}\nsetTheme(state.theme);\n\nfunction navRootName(name){\n if([\'subject\',\'lesson\',\'subjects\'].includes(name))return \'subjects\';\n if([\'quizSetup\',\'quizSession\',\'quizResult\',\'quiz\'].includes(name))return \'quiz\';\n if([\'flashSession\',\'flashResult\',\'flashcards\'].includes(name))return \'flashcards\';\n return name;\n}\nfunction renderNav(){\n const active=navRootName(route.name);\n const mk=([id,icon,label])=>`<button class="nav-btn ${active===id?\'active\':\'\'}" data-route="${id}"><span class="nav-icon">${icon}</span><span>${label}</span></button>`;\n document.querySelector(\'#desktop-nav\').innerHTML=NAV.map(mk).join(\'\');\n document.querySelector(\'#mobile-nav\').innerHTML=NAV.filter(x=>MOBILE.includes(x[0])).map(mk).join(\'\');\n}\nfunction setHeader(kicker,title){\n document.querySelector(\'#route-kicker\').textContent=kicker;\n document.querySelector(\'#route-title\').textContent=title;\n document.title=`${title} · NurseStudy`;\n}\nfunction hasNativeAds(){\n return typeof window.AndroidAds!==\'undefined\' && typeof window.AndroidAds.isAvailable===\'function\' && window.AndroidAds.isAvailable();\n}\nfunction adsAllowed(){\n return state.plan===\'free\'&&state.ads;\n}\nfunction isFocusedStudyRoute(){\n return [\'quizSession\',\'flashSession\'].includes(route.name);\n}\nfunction syncNativeAds(){\n if(!hasNativeAds())return;\n try{\n  if(typeof window.AndroidAds.setAdsEnabled===\'function\')window.AndroidAds.setAdsEnabled(Boolean(adsAllowed()));\n  if(typeof window.AndroidAds.setBannerVisible===\'function\')window.AndroidAds.setBannerVisible(Boolean(adsAllowed()&&!isFocusedStudyRoute()));\n }catch(_){/* warstwa natywna opcjonalna */}\n}\nfunction adSlot(){\n return adsAllowed()&&!hasNativeAds()&&!isFocusedStudyRoute()\n ? `<div class="ad-slot" aria-label="Miejsce na reklamę"><small>REKLAMA — miejsce testowe. W APK reklama jest renderowana natywnie przez AdMob.</small></div>`\n : \'\';\n}\nfunction notifyNativeQuizCompleted(){\n if(!adsAllowed()||!hasNativeAds())return;\n try{window.AndroidAds.onQuizCompleted()}catch(_){/* brak warstwy natywnej */}\n}\nfunction adPrivacyOptionsRequired(){\n if(!hasNativeAds()||typeof window.AndroidAds.isPrivacyOptionsRequired!==\'function\')return false;\n try{return Boolean(window.AndroidAds.isPrivacyOptionsRequired())}catch(_){return false}\n}\nfunction openAdPrivacyOptions(){\n if(hasNativeAds()&&typeof window.AndroidAds.showPrivacyOptions===\'function\'){\n  try{window.AndroidAds.showPrivacyOptions();return}catch(_){ }\n }\n toast(\'Opcje prywatności reklam są dostępne w wersji APK po skonfigurowaniu AdMob/UMP.\');\n}\nfunction statCard(icon,value,label){return `<div class="card stat"><div class="stat-icon">${icon}</div><div><strong>${value}</strong><small>${label}</small></div></div>`}\nfunction lessonsFor(id){return LESSONS[id]||[]}\nfunction subjectProgress(id){\n const ls=lessonsFor(id);\n if(!ls.length)return 0;\n const done=ls.filter(l=>state.completedLessons.includes(`${id}:${l.id}`)).length;\n return Math.round(done/ls.length*100);\n}\nfunction subjectCard(s){\n const count=lessonsFor(s.id).length,pct=subjectProgress(s.id);\n return `<article class="card subject-card"><div class="subject-top"><div class="subject-icon">${s.icon}</div><span class="badge">${count?count+\' lekcji\':\'w przygotowaniu\'}</span></div><h4>${s.name}</h4><p>${s.desc}</p><div class="subject-bottom"><div class="progress"><span style="width:${pct}%"></span></div><div class="meta-row"><span>${pct}% ukończone</span><span>•</span><span>semestr ${s.semester}</span></div><button class="secondary full" data-subject="${s.id}">${count?\'Otwórz przedmiot\':\'Zobacz plan\'}</button></div></article>`;\n}\nfunction getSchedule(id){return state.flashSchedule[id]||null}\nfunction getDueFlashcards(subject=\'mixed\'){\n const now=Date.now();\n return FLASHCARDS.filter(f=>(subject===\'mixed\'||f.subject===subject)&&getSchedule(f.id)?.due<=now);\n}\nfunction getNewFlashcards(subject=\'mixed\'){\n return FLASHCARDS.filter(f=>(subject===\'mixed\'||f.subject===subject)&&!getSchedule(f.id));\n}\nfunction getTodayCards(){\n const due=getDueFlashcards();\n const newOnes=getNewFlashcards().filter(f=>!due.some(d=>d.id===f.id)).slice(0,Math.max(0,8-due.length));\n return [...due,...newOnes];\n}\nfunction quizAverage(subject,limit=5){\n const h=quizHistoryFor(subject).slice(0,limit);\n return h.length?Math.round(h.reduce((sum,x)=>sum+(x.pct||0),0)/h.length):null;\n}\nfunction weakSubjectForPlan(){\n const candidates=SUBJECTS.filter(s=>QUESTIONS.filter(q=>q.subject===s.id).length>=5);\n if(!candidates.length)return \'mixed\';\n const scored=candidates.map(s=>{\n  const avg=quizAverage(s.id,5);\n  const wrong=state.reviewQuestions.filter(id=>QUESTIONS.some(q=>q.id===id&&q.subject===s.id)).length;\n  return {id:s.id,score:(avg===null?72:avg)-wrong*4};\n }).sort((a,b)=>a.score-b.score);\n return scored[0]?.id||state.lastSubject||\'farmakologia\';\n}\nfunction buildDailyPlan(){\n const steps=[];\n const cards=getTodayCards();\n if(cards.length)steps.push({type:\'flash\',ids:cards.map(f=>f.id),label:`${cards.length} fiszek`});\n const wrongIds=[...state.reviewQuestions];\n if(wrongIds.length)steps.push({type:\'quiz\',ids:wrongIds.slice(0,10),subject:\'mixed\',label:`${Math.min(10,wrongIds.length)} błędnych pytań`,mode:\'Plan dnia · błędy\'});\n const weak=weakSubjectForPlan();\n const weakPool=shuffle(quizPool(weak)).filter(q=>!wrongIds.includes(q.id)).slice(0,5);\n if(weakPool.length)steps.push({type:\'quiz\',ids:weakPool.map(q=>q.id),subject:weak,label:`${weakPool.length} pytań · słabszy dział`,mode:\'Plan dnia · utrwalenie\'});\n return steps;\n}\nfunction estimatedTodayMinutes(){\n const steps=buildDailyPlan();\n const flash=steps.filter(s=>s.type===\'flash\').reduce((n,s)=>n+s.ids.length,0);\n const qs=steps.filter(s=>s.type===\'quiz\').reduce((n,s)=>n+s.ids.length,0);\n return Math.max(6,Math.min(30,Math.ceil(flash*.45+qs*.85+2)));\n}\nfunction addStudyMinutes(n){\n ensureToday();\n recordStudyDay();\n state.todayMinutes+=n;\n state.minutes+=n;\n save();\n}\nfunction continueLessonInfo(){\n const s=SUBJECTS.find(x=>x.id===state.lastSubject);\n const l=lessonsFor(state.lastSubject).find(x=>x.id===state.lastLesson);\n return s&&l?{s,l}:null;\n}\n'
txt=replace_between(txt,"function localDay(){","\n\nfunction renderDashboard(){",NEW_HELPERS)

NEW_DASHBOARD='function renderDashboard(){\n setHeader(\'Dzień dobry\',\'Twój plan nauki\');\n ensureToday();\n const acc=state.questions?Math.round(state.correct/state.questions*100):0;\n const due=getDueFlashcards().length,newCount=getNewFlashcards().length,errors=state.reviewQuestions.length;\n const plan=buildDailyPlan(),est=estimatedTodayMinutes();\n const goal=20,pct=Math.min(100,Math.round((state.todayMinutes/goal)*100));\n const cont=continueLessonInfo();\n main.innerHTML=`<section class="hero">\n <div class="hero-main"><div class="hero-badges"><span class="pill" style="background:rgba(255,255,2