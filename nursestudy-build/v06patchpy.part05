return MainActivity.this.isPrivacyOptionsRequired();\n        }\n\n        @JavascriptInterface\n        public void onQuizCompleted() {\n            runOnUiThread(() -> {\n                if (!adsEnabledByPlan) return;\n                if (consentInformation == null || consentInformation.canRequestAds() || BuildConfig.DEBUG) {\n                    maybeShowInterstitialAfterQuiz();\n                }\n            });\n        }\n\n        @JavascriptInterface\n        public void setAdsEnabled(boolean enabled) {\n            runOnUiThread(() -> MainActivity.this.setAdsEnabled(enabled));\n        }\n\n        @JavascriptInterface\n        public void setBannerVisible(boolean visible) {\n            runOnUiThread(() -> MainActivity.this.setBannerContextVisible(visible));\n        }\n\n        @JavascriptInterface\n        public void showPrivacyOptions() {\n            runOnUiThread(MainActivity.this::showPrivacyOptions);\n        }\n    }\n\n    @Override\n    public void onBackPressed() {\n        if (webView == null) {\n            super.onBackPressed();\n            return;\n        }\n\n        webView.evaluateJavascript(\n                "(function(){try{return !!(window.NurseStudyNavigation&&window.NurseStudyNavigation.back());}catch(e){return false;}})()",\n                value -> {\n                    if (!"true".equals(value)) {\n                        MainActivity.super.onBackPressed();\n                    }\n                });\n    }\n\n    @Override\n    protected void onDestroy() {\n        if (bannerAd != null) {\n            bannerAd.destroy();\n            bannerAd = null;\n        }\n        if (webView != null) {\n            webView.removeJavascriptInterface("AndroidAds");\n            webView.destroy();\n            webView = null;\n        }\n        super.onDestroy();\n    }\n}\n'\n(root/"app/src/main/java/pl/nursestudy/app/MainActivity.java").write_text(JAVA)\n\nbg=root/"app/build.gradle"\nb=bg.read_text().replace("versionCode 5","versionC