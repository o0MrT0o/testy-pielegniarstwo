55,.15);color:white">PLAN NA DZIŚ · ~${est} MIN</span>${state.streak?`<span class="pill" style="background:rgba(255,255,255,.15);color:white">🔥 ${state.streak} dni</span>`:\'\'}</div>\n <h2>Powtórz to, co naprawdę wymaga powtórki.</h2>\n <p>${plan.length?plan.map(x=>x.label).join(\' · \'):\'Na dziś nie masz zaległych powtórek — możesz zrobić dowolny quiz lub lekcję.\'}</p>\n <div class="hero-actions">${plan.length?\'<button class="primary" data-start-daily="1">Zacznij plan dnia</button>\':\'<button class="primary" data-route="quiz">Zrób quiz</button>\'}<button class="secondary" data-route="reviews">Powtórki</button></div></div>\n <div class="card daily"><div><span class="badge">AKTYWNOŚĆ DZISIAJ</span><h3>Cel: 20 min</h3><p style="color:var(--muted)">Zarejestrowano: ${state.todayMinutes} min</p></div><div class="daily-ring" style="--pct:${pct}%"><strong>${pct}%</strong></div><small style="color:var(--muted);text-align:center">Czas jest szacowany z ukończonych aktywności, nie jest zegarem.</small></div></section>\n ${cont?`<section class="card continue-card"><div><span class="badge">KONTYNUUJ NAUKĘ</span><h3>${cont.s.icon} ${cont.s.name} · ${cont.l.title}</h3><p>${cont.l.time} · ${state.completedLessons.includes(`${cont.s.id}:${cont.l.id}`)?\'materiał już ukończony — możesz powtórzyć\':\'wróć dokładnie do ostatniej lekcji\'}</p></div><button class="secondary" data-continue-lesson="${cont.s.id}:${cont.l.id}">Kontynuuj →</button></section>`:\'\'}\n <section class="grid grid-4">${statCard(\'↻\',due,\'fiszek do powtórki\')}${statCard(\'?\',errors,\'błędnych pytań\')}${statCard(\'✓\',acc+\'%\',\'skuteczność quizów\')}${statCard(\'🔥\',state.streak||0,\'dni serii\')}</section>\n <div class="section-title"><h3>Najbardziej rozbudowane moduły</h3><button class="link-btn" data-route="subjects">Wszystkie przedmioty</button></div>\n <section class="grid grid-3">${[\'podstawy\',\'farmakologia\',\'interna\'].map(id=>subjectCard(SUBJECTS.find(s=>s.id===id))).join(\'\')}</section>\n ${state.plan===\'free\'?`<section class="card premium-compact"><div><span class="pill">PREMIUM</span><h3>Nauka bez reklam</h3><p>Premium będzie usuwać reklamy i odblokowywać rozszerzone statystyki. Płatności są jeszcze wyłączone w buildzie testowym.</p></div><button class="secondary" data-route="premium">Zobacz Premium</button></section>`:\'\'}\n ${adSlot()}\n <div class="card content-status"><div><span class="pill">WERYFIKACJA MERYTORYCZNA</span><h3>Treści kliniczne zweryfikowane ${VERIFIED_AT}</h3><p>Źródła obejmują WHO, NICE, ESC, ADA, GOLD, ERC oraz aktualne podręczniki akademickie.</p></div><button class="secondary" data-route="sources">Zobacz bibliografię</button></div>`;\n syncNativeAds();\n}\n'
txt=replace_between(txt,"function renderDashboard(){","\n\nfunction renderSubjects(){",NEW_DASHBOARD)

txt=txt.replace(
"""function quizBest(subject){
 const h=quizHistoryFor(subject);
 return h.length?Math.max(...h.map(x=>x.pct||0)):null;
}""",
"""function quizBest(subject){
 const h=quizHistoryFor(subject);
 return h.length?Math.max(...h.map(x=>x.pct||0)):null;
}
function latestFullBank(subject){
 return quizHistoryFor(subject).find(h=>h.mode==='Pełny bank')||null;
}"""
)
txt=txt.replace("const history=quizHistoryFor(subject),best=quizBest(subject);",
                "const history=quizHistoryFor(subject),avg=quizAverage(subject,5),full=latestFullBank(subject);")
txt=txt.replace("${statCard('▣',history.length,'ukończonych quizów')}${statCard('★',best===null?'—':best+'%','najlepszy wynik')}${statCard('↻',wrong,'pytań do powtórki')}",
                "${statCard('▣',history.length,'ukończonych quizów')}${statCard('≈',avg===null?'—':avg+'%','średnia z ostatnich 5')}${statCard('▤',full?full.pct+'%':'—','ostatni pełny bank')}${statCard('↻',wrong,'pytań do powtórki')}")
txt=txt.replace("best=quizBest(s.id),sessions=quizHistoryFor(s.id).length",
                "avg=quizAverage(s.id,5),sessions=quizHistoryFor(s.id).length")
txt=txt.replace("rekord: ${best===null?'—':best+'%'}","śr. 5: ${avg===null?'—':avg+'%'}")

NEW_START_QUIZ="function startQuiz(subject='mixed',ids=null,options={}){\n let pool=ids?QUESTIONS.filter(q=>ids.includes(q.id)):quizPool(subject,options.topic||null);\n if(!pool.length){toast('Dla tego zestawu nie ma pytań.');return go('quiz')}\n const requested=options.count==='all'||options.count==null?pool.length:Number(options.count);\n pool=shuffle(pool).slice(0,Math.min(requested,pool.length));\n pushRoute({name:'quizSession',subject});\n quizSession={\n  pool,index:0,score:0,answered:false,selected:null,reviewMode:Boolean(ids),\n  subject,topic:options.topic||null,mode:options.mode||(ids?'Powtórka':requested===pool.length?'Pełny bank':`${pool.length} pytań`),\n  startedAt:Date.now(),mistakes:[],responses:[],dailyPlan:Boolean(options.dailyPlan),resultSaved:false\n };\n renderQuizQuestion();\n}"
txt=replace_between(txt,"function startQuiz(subject='mixed',ids=null,options={}){","\nfunction renderQuizHub(){",NEW_START_QUIZ)

NEW_RESULT='function renderQuizResult(){\n const total=quizSession.pool.length,pct=Math.round(quizSession.score/total*100);\n const seconds=Math.max(1,Math.round((Date.now()-quizSession.startedAt)/1000));\n const minutes=Math.floor(seconds/60),rest=seconds%60,timeLabel=minutes?`${minutes} min ${rest} s`:`${rest} s`;\n if(!quizSession.resultSaved){\n  const historyEntry={subject:quizSession.subject,topic:quizSession.topic,mode:quizSession.mode,pct,score:quizSession.score,total,seconds,date:Date.now()};\n  state.quizHistory.unshift(historyEntry);state.quizHistory=state.quizHistory.slice(0,60);\n  state.xp+=quizSession.score*10;addStudyMinutes(Math.max(2,Math.ceil(total*.8)));save();\n  quizSession.resultSaved=true;\n }\n route={name:\'quizResult\',subject:quizSession.subject};renderNav();syncNativeAds();\n setHeader(\'Quiz zakończony\',\'Twój wynik\');\n const mistakes=quizSession.mistakes;\n const dailyNext=quizSession.dailyPlan&&dailyPlanSession&&dailyPlanSession.index<dailyPlanSession.steps.length-1;\n main.innerHTML=`<section class="quiz-shell result-shell"><article class="card quiz-result"><span class="badge">${quizSession.mode.toUpperCase()}</span><div class="score">${pct}%</div><h2>${pct>=90?\'Świetny wynik\':pct>=80?\'Bardzo dobrze\':pct>=60?\'Dobry kierunek\':\'Warto zrobić powtórkę\'}</h2>\n <p style="color:var(--muted)">${quizSession.score} / ${total} poprawnych odpowiedzi.</p>\n <div class="result-stats"><div><strong>${timeLabel}</strong><span>czas</span></div><div><strong>${mistakes.length}</strong><span>błędów</span></div><div><strong>${quizSession.score*10}</strong><span>XP</span></div></div>\n <div class="hero-actions" style="justify-content:center">${dailyNext?\'<button class="primary" data-daily-continue="1">Kontynuuj plan dnia →</button>\':`<button class="primary" data-quiz-setup="${quizSession.subject}">Nowy quiz</button>`}${mistakes.length?\'<button class="secondary" data-result-errors="1">Przejrzyj błędy</button>\':\'\'}<button class="ghost" data-route="reviews">Powtórki</button></div></article>\n ${mistakes.length?`<div class="card result-errors hidden" id="result-errors"><div class="section-title"><h3>Błędy z tej sesji</h3><span class="badge">${mistakes.length}</span></div>${mistakes.map((m,i)=>{const src=MEDICAL_SOURCES[m.source];return `<article class="mistake-row"><div class="mistake-number">${i+1}</div><div><strong>${m.q}</strong><p><span class="bad-text">Twoja odpowiedź:</span> ${m.answers[m.selected]}</p><p><span class="good-text">Poprawna:</span> ${m.answers[m.correct]}</p><small>${m.topic||\'\'}${src?` · ${src.org}`:\'\'}</small></div></article>`}).join(\'\')}</div>`:\'\'}\n ${adSlot()}</section>`;\n if(!quizSession.dailyPlan)setTimeout(notifyNativeQuizCompleted,250);\n}'
txt=replace_between(txt,"function renderQuizResult(){","\nfunction renderFlashHub(){",NEW_RESULT)

NEW_FLASH='function startFlash(subject=\'mixed\',ids=null,options={}){\n let cards;\n if(ids)cards=FLASHCARDS.filter(f=>ids.includes(f.id));\n else if(subject===\'today\')cards=getTodayCards();\n else cards=subject===\'mixed\'?FLASHCARDS:FLASHCARDS.filter(f=>f.subject===subject);\n if(!cards.length){toast(\'Na teraz nie ma kart w tym zestawie.\');return go(\'flashcards\')}\n pushRoute({name:\'flashSession\'});\n flashSession={cards:shuffle(cards),index:0,known:0,again:0,revealed:false,dailyPlan:Boolean(options.dailyPlan)};\n renderFlashCard();\n}\nfunction revealFlash(){\n if(!flashSession||flashSession.revealed)return;\n flashSession.revealed=true;\n document.querySelector(\'#flashcard\')?.classList.add(\'flipped\');\n document.querySelector(\'#flash-actions\')?.classList.remove(\'hidden\');\n}\nfunction renderFlashCard(){\n const f=flashSession.cards[flashSession.index],src=MEDICAL_SOURCES[f.source];\n flashSession.revealed=false;\n setHeader(\'Fiszki\',`${flashSession.index+1} z ${flashSession.cards.length}`);\n main.inn