NEW_ROUTING='function resetState(){\n const theme=state.theme;\n state=JSON.parse(JSON.stringify(defaults));\n state.theme=theme;state.todayDate=localDay();\n navStack=[];dailyPlanSession=null;quizSession=null;flashSession=null;\n save();setTheme(theme);go(\'dashboard\',{},false);toast(\'Wyczyszczono lokalny postęp\');\n}\nfunction renderRoute(){\n renderNav();syncNativeAds();window.scrollTo({top:0,behavior:\'smooth\'});\n if(route.name===\'dashboard\')renderDashboard();\n else if(route.name===\'subjects\')renderSubjects();\n else if(route.name===\'subject\')renderSubject(route.subject);\n else if(route.name===\'lesson\')renderLesson(route.subject,route.lesson);\n else if(route.name===\'quiz\')renderQuizHub();\n else if(route.name===\'quizSetup\')renderQuizSetup(route.subject||\'mixed\');\n else if(route.name===\'quizSession\'&&quizSession)renderQuizQuestion();\n else if(route.name===\'quizResult\'&&quizSession)renderQuizResult();\n else if(route.name===\'flashcards\')renderFlashHub();\n else if(route.name===\'flashSession\'&&flashSession)renderFlashCard();\n else if(route.name===\'flashResult\'&&flashSession){route={name:\'flashcards\'};renderFlashHub()}\n else if(route.name===\'reviews\')renderReviews();\n else if(route.name===\'sources\')renderSources();\n else if(route.name===\'premium\')renderPremium();\n else if(route.name===\'settings\')renderSettings();\n else if(route.name===\'legal\')renderLegal(route.type);\n else {route={name:\'dashboard\'};renderDashboard()}\n}\nfunction pushRoute(next){\n if(route?.name)navStack.push({...route});\n route={...next};renderNav();syncNativeAds();window.scrollTo({top:0,behavior:\'smooth\'});\n}\nfunction go(name,params={},push=true){\n if(push&&route?.name&&(route.name!==name||JSON.stringify({...route,name:undefined})!==JSON.stringify(params)))navStack.push({...route});\n route={name,...params};renderRoute();\n}\nfunction backInApp(){\n const modalRoot=document.querySelector(\'#modal-root\');\n if(modalRoot?.innerHTML){modalRoot.innerHTML=\'\';return true}\n if(route.name===\'quizSession\'&&quizSession&&!quizSession.resultSaved){\n  modal(\'Zakończyć quiz?\',`<p>Ta niedokończona sesja nie zostanie zapisana w historii wyników.</p><button class="danger-button full" data-confirm-exit-quiz="1">Tak, zakończ quiz</button>`);\n  return true;\n }\n if(navStack.length){\n  route=navStack.pop();renderRoute();return true;\n }\n return false;\n}\nwindow.NurseStudyNavigation={back:backInApp};\n\nfunction startDailyPlan(){\n const steps=buildDailyPlan();\n if(!steps.length){toast(\'Nie masz teraz zaległego planu.\');return go(\'quiz\')}\n dailyPlanSession={steps,index:0,startedAt:Date.now()};\n runDailyPlanStep();\n}\nfunction runDailyPlanStep(){\n if(!dailyPlanSession)return go(\'dashboard\');\n const step=dailyPlanSession.steps[dailyPlanSession.index];\n if(!step)return finishDailyPlan();\n if(step.type===\'flash\')return startFlash(\'mixed\',step.ids,{dailyPlan:true});\n if(step.type===\'quiz\')return startQuiz(step.subject||\'mixed\',step.ids,{mode:step.mode||\'Plan dnia\',dailyPlan:true,count:\'all\'});\n}\nfunction continueDailyPlan(){\n if(!dailyPlanSession)return go(\'dashboard\');\n dailyPlanSession.index++;\n if(dailyPlanSession.index>=dailyPlanSession.steps.length)return finishDailyPlan();\n runDailyPlanStep();\n}\nfunction finishDailyPlan(){\n const count=dailyPlanSession?.steps.length||0;\n state.dailyPlansCompleted=(state.dailyPlansCompleted||0)+1;state.xp+=20;save();\n dailyPlanSession=null;quizSession=null;flashSession=null;\n go(\'dashboard\',{},false);\n toast(`Plan dnia ukończony · ${count} etapy · +20 XP`);\n notifyNativeQuizCompleted();\n}\n'
txt=replace_between(txt,"function resetState(){","\ndocument.addEventListener('click'",NEW_ROUTING)

