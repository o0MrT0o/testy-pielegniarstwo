te FrameLayout adContainer;\n    private AdView bannerAd;\n    private InterstitialAd interstitialAd;\n    private ConsentInformation consentInformation;\n\n    private boolean adsInitialized = false;\n    private boolean adsEnabledByPlan = true;\n    private boolean bannerContextVisible = true;\n    private boolean bannerLoaded = false;\n    private int completedQuizzesSinceInterstitial = 0;\n\n    @Override\n    protected void onCreate(Bundle savedInstanceState) {\n        super.onCreate(savedInstanceState);\n        createLayout();\n        configureWebView();\n        requestConsentAndInitializeAds();\n        webView.loadUrl("file:///android_asset/www/index.html");\n    }\n\n    private void createLayout() {\n        LinearLayout root = new LinearLayout(this);\n        root.setOrientation(LinearLayout.VERTICAL);\n\n        webView = new WebView(this);\n        root.addView(webView, new LinearLayout.LayoutParams(\n                LinearLayout.LayoutParams.MATCH_PARENT,\n                0,\n                1f));\n\n        adContainer = new FrameLayout(this);\n        adContainer.setVisibility(View.GONE);\n        root.addView(adContainer, new LinearLayout.LayoutParams(\n                LinearLayout.LayoutParams.MATCH_PARENT,\n                LinearLayout.LayoutParams.WRAP_CONTENT));\n\n        setContentView(root);\n    }\n\n    private void configureWebView() {\n        WebSettings settings = webView.getSettings();\n        settings.setJavaScriptEnabled(true);\n        settings.setDomStorageEnabled(true);\n        settings.setAllowFileAccess(true);\n        settings.setAllowContentAccess(true);\n        settings.setBuiltInZoomControls(false);\n        settings.setDisplayZoomControls(false);\n\n        webView.addJavascriptInterface(new AdsBridge(), "AndroidAds");\n        webView.setWebViewClient(new WebViewClient() {\n            @Override\n            public boolean shouldOverrideUrlLoading(WebView view, WebResourceRequest request) {\n                Uri uri = request.getUrl();\n                String scheme = uri.getScheme();\n                if ("http".equalsIgnoreCase(scheme) || "https".equalsIgnoreCase(scheme)) {\n                    startActivity(new Intent(Intent.ACTION_VIEW, uri));\n                    return true;\n                }\n                return false;\n            }\n        });\n    }\n\n    private void requestConsentAndInitializeAds() {\n        consentInformation = UserMessagingPlatform.getConsentInformation(this);\n        ConsentRequestParameters params = new ConsentRequestParameters.Builder()\n                .setTagForUnderAgeOfConsent(false)\n                .build();\n\n        consentInformation.requestConsentInfoUpdate(\n                this,\n                params,\n                () -> {\n                    UserMessagingPlatform.loadAndShowConsentFormIfRequired(\n                            this,\n                            formError -> {\n                                if (consentInformation.canRequestAds()) {\n                                    initializeAdsOnce();\n                                }\n                            });\n\n                    if (consentInformation.canRequestAds()) {\n                        initializeAdsOnce();\n                    }\n                },\n                requestConsentError -> {\n                    if (consentInformation.canRequestAds()) {\n                        initializeAdsOnce();\n                    } else if (BuildConfig.DEBUG) {\n                        initializeAdsOnce();\n                    }\n                });\n    }\n\n    private synchronized void initializeAdsOnce() {\n        if (adsInitialized) return;\n        adsInitialized = true;\n\n        new Thread(() -> MobileAds.initialize(this, initializationStatus ->\n                runOnUiThread(() -> {\n                    if (adsEnabledByPlan) {\n                        loadBanner();\n                        loadInterstitial();\n                    }\n                }))).start();\n    }\n\n    private void loadBanner() {\n        if (!adsEnabledByPlan) return;\n\n        if (bannerAd != null) {\n            bannerAd.destroy();\n            bannerAd = null;\n        }\n        bannerLoaded = false;\n\n        bannerAd = new AdView(this);\n        bannerAd.setAdUnitId(BuildConfig.ADMOB_BANNER_ID);\n        bannerAd.setAdSize(getAdaptiveBannerSize());\n        bannerAd.setAdListener(new AdListener() {\n            @Override\n            public void onAdLoaded() {\n                bannerLoaded = true;\n                updateBannerVisibility();\n            }\n\n            @Override\n            public void onAdFailedToLoad(LoadAdError error) {\n                bannerLoaded = false;\n                updateBannerVisibility();\n            }\n        });\n\n        adContainer.removeAllViews();\n        adContainer.addView(bannerAd);\n        updateBannerVisibility();\n        bannerAd.loadAd(new AdRequest.Builder().build());\n    }\n\n    private AdSize getAdaptiveBannerSize() {\n        DisplayMetrics metrics = getResources().getDisplayMetrics();\n        int widthPixels = adContainer.getWidth();\n        if (widthPixels <= 0) widthPixels = metrics.widthPixels;\n        int widthDp = Math.max(1, (int) (widthPixels / metrics.density));\n        return AdSize.getCurrentOrientationAnchoredAdaptiveBannerAdSize(this, widthDp);\n    }\n\n    private void updateBannerVisibility() {\n        runOnUiThread(() -> adContainer.setVisibility(\n                adsEnabledByPlan && bannerContextVisible && bannerLoaded\n                        ? View.VISIBLE\n                        : View.GONE));\n    }\n\n    private void loadInterstitial() {\n        if (!adsEnabledByPlan) return;\n\n        InterstitialAd.load(\n                this,\n                BuildConfig.ADMOB_INTERSTITIAL_ID,\n                new AdRequest.Builder().build(),\n                new InterstitialAdLoadCallback() {\n                    @Override\n                    public void onAdLoaded(InterstitialAd ad) {\n                        interstitialAd = ad;\n                    }\n\n                    @Override\n                    public void onAdFailedToLoad(LoadAdError error) {\n                        interstitialAd = null;\n                    }\n                });\n    }\n\n    private void setAdsEnabled(boolean enabled) {\n        adsEnabledByPlan = enabled;\n\n        if (!enabled) {\n            adContainer.setVisibility(View.GONE);\n            bannerLoaded = false;\n            if (bannerAd != null) {\n                bannerAd.destroy();\n                bannerAd = null;\n            }\n            adContainer.removeAllViews();\n            interstitialAd = null;\n            completedQuizzesSinceInterstitial = 0;\n            return;\n        }\n\n        if (adsInitialized) {\n            if (bannerAd == null) loadBanner();\n            if (interstitialAd == null) loadInterstitial();\n        }\n        updateBannerVisibility();\n    }\n\n    private void setBannerContextVisible(boolean visible) {\n        bannerContextVisible = visible;\n        if (visible && adsEnabledByPlan && adsInitialized && bannerAd == null) {\n            loadBanner();\n        } else {\n            updateBannerVisibility();\n        }\n    }\n\n    private void maybeShowInterstitialAfterQuiz() {\n        if (!adsEnabledByPlan) return;\n\n        completedQuizzesSinceInterstitial++;\n        if (completedQuizzesSinceInterstitial < 2 || interstitialAd == null) return;\n\n        completedQuizzesSinceInterstitial = 0;\n        InterstitialAd ad = interstitialAd;\n        interstitialAd = null;\n        ad.setFullScreenContentCallback(new FullScreenContentCallback() {\n            @Override\n            public void onAdDismissedFullScreenContent() {\n                if (adsEnabledByPlan) loadInterstitial();\n            }\n\n            @Override\n            public void onAdFailedToShowFullScreenContent(AdError adError) {\n                if (adsEnabledByPlan) loadInterstitial();\n            }\n        });\n        ad.show(this);\n    }\n\n    private boolean isPrivacyOptionsRequired() {\n        return consentInformation != null\n                && consentInformation.getPrivacyOptionsRequirementStatus()\n                == ConsentInformation.PrivacyOptionsRequirementStatus.REQUIRED;\n    }\n\n    private void showPrivacyOptions() {\n        if (!isPrivacyOptionsRequired()) {\n            Toast.makeText(this, "Dodatkowe opcje prywatności nie są obecnie wymagane.", Toast.LENGTH_SHORT).show();\n            return;\n        }\n\n        UserMessagingPlatform.showPrivacyOptionsForm(this, formError -> {\n            if (consentInformation.canRequestAds()) initializeAdsOnce();\n        });\n    }\n\n    private class AdsBridge {\n        @JavascriptInterface\n        public boolean isAvailable() {\n            return true;\n        }\n\n        @JavascriptInterface\n        public boolean isPrivacyOptionsRequired() {\n            