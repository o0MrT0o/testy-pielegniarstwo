+function shuffle(items){
+ const a=[...items];
+ for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}
+ return a;
+}
+function quizPool(subject='mixed',topic=null){
+ let pool=subject==='mixed'?QUESTIONS:QUESTIONS.filter(q=>q.subject===subject);
+ if(topic)pool=pool.filter(q=>q.topic===topic);
+ return pool;
+}
+function quizHistoryFor(subject){
+ return state.quizHistory.filter(h=>subject==='mixed'||h.subject===subject);
+}
+function quizBest(subject){
+ const h=quizHistoryFor(subject);
+ return h.length?Math.max(...h.map(x=>x.pct||0)):null;
+}
+function renderQuizSetup(subject='mixed'){
+ const s=SUBJECTS.find(x=>x.id===subject);
+ const pool=quizPool(subject);
+ if(!pool.length){toast('Dla tego zestawu nie ma jeszcze zweryfikowanych pytań.');return go('quiz')}
+ const topics=[...new Set(pool.map(q=>q.topic).filter(Boolean))];
+ const wrong=pool.filter(q=>state.reviewQuestions.includes(q.id)).length;
+ const history=quizHistoryFor(subject),best=quizBest(subject);
+ setHeader('Konfiguracja quizu',s?s.name:'Wszystkie przedmioty');
+ route={name:'quizSetup',subject};renderNav();
+ const quick=Math.min(10,pool.length),standard=Math.min(20,pool.length);
+ main.innerHTML=`<section class="quiz-setup">
+ <div class="page-head"><div><span class="badge">${s?s.name:'MIX PRZEDMIOTÓW'}</span><h2>Wybierz tryb quizu</h2><p>Ustaw długość i zakres. Pytania są losowane bez powtórzeń, a wynik zapisuje się w historii na tym urządzeniu.</p></div><button class="ghost" data-route="quiz">← Wróć</button></div>
+ <section class="grid grid-4 quiz-mode-grid">
+  <button class="card quiz-mode" data-quiz-config="${subject}|${quick}|"><strong>⚡ ${quick} pytań</strong><span>Szybka sesja</span><small>Dobry tryb na krótką powtórkę.</small></button>
+  ${pool.length>10?`<button class="card quiz-mode" data-quiz-config="${subject}|${standard}|"><strong>◎ ${standard} pytań</strong><span>Standard</span><small>Większa próba wiedzy.</small></button>`:''}
+  <button class="card quiz-mode" data-quiz-config="${subject}|all|"><strong>▤ ${pool.length} pytań</strong><span>Pełny bank</span><small>Wszystkie dostępne pytania z zestawu.</small></button>
+  <button class="card quiz-mode ${wrong?'':'is-disabled'}" ${wrong?`data-quiz-wrong="${subject}"`:''}><strong>↻ ${wrong} błędnych</strong><span>Tylko powtórka</span><small>${wrong?'Pytania, na które wcześniej odpowiedziałeś źle.':'Brak błędnych pytań w tym zestawie.'}</small></button>
+ </section>
+ ${topics.length>1?`<div class="section-title"><h3>Albo wybierz konkretny dział</h3><span class="badge">${topics.length} działów</span></div>
+ <section class="grid grid-2 topic-grid">${topics.map(topic=>{const n=pool.filter(q=>q.topic===topic).length;return `<button class="card topic-option" data-quiz-topic="${subject}|${encodeURIComponent(