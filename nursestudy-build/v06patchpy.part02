erHTML=`<section class="flash-shell"><div class="quiz-top"><span style="color:var(--muted)">Najpierw odpowiedz w głowie</span><span class="badge">${flashSession.known} zaliczone</span></div>\n <div class="progress"><span style="width:${flashSession.index/flashSession.cards.length*100}%"></span></div>\n <div class="flashcard" id="flashcard" tabindex="0" role="button" aria-label="Pokaż odpowiedź"><div class="flash-inner"><div class="flash-face front"><span>Pytanie</span><h2>${f.front}</h2><small style="color:var(--muted)">Dotknij, aby odkryć odpowiedź</small></div><div class="flash-face back"><span>Odpowiedź</span><h2>${f.back}</h2><small style="color:var(--muted)">Źródło: ${src?.org||\'bibliografia\'} · ${src?.year||\'\'}</small></div></div></div>\n <div class="flash-actions four hidden" id="flash-actions"><button class="action-btn danger" data-flash-rate="again">↻ Nie pamiętam</button><button class="action-btn hard" data-flash-rate="hard">~ Trudne</button><button class="action-btn success" data-flash-rate="good">✓ Dobrze</button><button class="action-btn easy" data-flash-rate="easy">★ Łatwe</button></div></section>`;\n syncNativeAds();\n}\nfunction scheduleFlash(id,rating){\n const day=86400000,now=Date.now();\n let x=state.flashSchedule[id]||{interval:0,ease:2.5,reps:0,due:0};\n if(rating===\'again\'){x.reps=0;x.interval=0;x.ease=Math.max(1.3,x.ease-.2);x.due=now+10*60*1000;}\n if(rating===\'hard\'){x.reps+=1;x.interval=Math.max(1,Math.round((x.interval||1)*1.2));x.ease=Math.max(1.3,x.ease-.15);x.due=now+x.interval*day;}\n if(rating===\'good\'){x.reps+=1;x.interval=x.reps===1?1:x.reps===2?3:Math.max(3,Math.round((x.interval||1)*x.ease));x.due=now+x.interval*day;}\n if(rating===\'easy\'){x.reps+=1;x.ease=Math.min(3.0,x.ease+.15);x.interval=x.reps===1?4:Math.max(4,Math.round((x.interval||1)*x.ease*1.3));x.due=now+x.interval*day;}\n state.flashSchedule[id]=x;\n return x;\n}\nfunction rateFlash(rate){\n if(!flashSession?.revealed){toast(\'Najpierw odkryj odpowiedź.\');return}\n const f=flashSession.cards[flashSession.index];scheduleFlash(f.id,rate);\n if(rate===\'again\'||rate===\'hard\'){\n  flashSession.again++;\n  if(!state.hardFlashcards.includes(f.id))state.hardFlashcards.push(f.id);\n }else{\n  flashSession.known++;state.flashKnown++;\n  state.hardFlashcards=state.hardFlashcards.filter(id=>id!==f.id);\n }\n save();\n if(flashSession.index<flashSession.cards.length-1){flashSession.index++;renderFlashCard()}\n else{\n  addStudyMinutes(Math.max(2,Math.ceil(flashSession.cards.length*.45)));\n  route={name:\'flashResult\'};renderNav();syncNativeAds();\n  setHeader(\'Fiszki\',\'Sesja zakończona\');\n  const dailyNext=flashSession.dailyPlan&&dailyPlanSession&&dailyPlanSession.index<dailyPlanSession.steps.length-1;\n  main.innerHTML=`<section class="flash-shell"><article class="card quiz-result"><div class="score">${flashSession.known}/${flashSession.cards.length}</div><h2>Sesja zakończona</h2><p style="color:var(--muted)">${flashSession.again} kart oznaczono jako wymagające szybszej powtórki. Wrócą dopiero w zapisanym terminie.</p><div class="hero-actions" style="justify-content:center">${dailyNext?\'<button class="primary" data-daily-continue="1">Kontynuuj plan dnia →</button>\':\'<button class="primary" data-route="reviews">Zobacz powtórki</button>\'}<button class="secondary" data-start-flash="today">Nowa sesja fiszek</button></div></article></section>`;\n }\n}'
txt=replace_between(txt,"function startFlash(subject='mixed',ids=null){","\nfunction renderReviews(){",NEW_FLASH)

NEW_REVIEWS='function renderReviews(){\n setHeader(\'Ucz się na błędach\',\'Powtórki\');\n const qs=QUESTIONS.filter(q=>state.reviewQuestions.includes(q.id));\n const fs=getDueFlashcards();\n const dueIds=new Set(fs.map(f=>f.id));\n const hardFuture=state.hardFlashcards.filter(id=>!dueIds.has(id)&&getSchedule(id)?.due>Date.now()).length;\n main.innerHTML=`<div class="page-head"><div><h2>Powtórki</h2><p>Pytania pozostają tu do dwóch kolejnych poprawnych odpowiedzi. Fiszki pojawiają się dopiero wtedy, gdy nadejdzie zapisany termin — oznaczenie „Trudne” nie omija harmonogramu.</p></div></div>\n ${hardFuture?`<div class="callout"><strong>${hardFuture} trudnych fiszek czeka na swój termin</strong>Nie pokazujemy ich przed czasem; system przywróci je automatycznie zgodnie z harmonogramem.</div>`:\'\'}\n <section class="grid grid-2"><div class="card"><div class="section-title" style="margin-top:0"><h3>Błędne pytania</h3><span class="badge">${qs.length}</span></div>\n ${qs.length?qs.map(q=>`<div class="setting-row"><div><strong>${q.q}</strong><small style="display:block;color:var(--muted)">${SUBJECTS.find(s=>s.id===q.subject)?.name} · seria poprawnych: ${state.questionStats[q.id]?.streak||0}/2</small></div></div>`).join(\'\')+`<button class="primary full" style="margin-top:16px" data-review-quiz="1">Powtórz pytania</button>`:`<div class="empty"><div class="big">✓</div><p>Brak pytań wymagających powtórki.</p></div>`}</div>\n <div class="card"><div class="section-title" style="margin-top:0"><h3>Fiszki do powtórki teraz</h3><span class="badge">${fs.length}</span></div>\n ${fs.length?fs.map(f=>`<div class="setting-row"><div><strong>${f.front}</strong><small style="display:block;color:var(--muted)">${SUBJECTS.find(s=>s.id===f.subject)?.name}</small></div></div>`).join(\'\')+`<button class="primary full" style="margin-top:16px" data-review-flash="1">Powtórz fiszki</button>`:`<div class="empty"><div class="big">🧠</div><p>Brak fiszek z terminem na teraz.</p></div>`}</div></section>`;\n syncNativeAds();\n}'
txt=replace_between(txt,"function renderReviews(){","\n\nfunction renderSources(){",NEW_REVIEWS)

NEW_SETTINGS='function renderSettings(){\n setHeader(\'Konto i prywatność\',\'Ustawienia\');\n main.innerHTML=`<div class="page-head"><div><h2>Ustawienia</h2><p>Dane postępu w tej wersji są przechowywane lokalnie na urządzeniu.</p></div></div>\n <section class="grid grid-2">\n <div class="card"><h3>Wygląd</h3><div class="setting-row"><div><strong>Tryb ciemny</strong><small style="display:block;color:var(--muted)">Zmienia motyw interfejsu.</small></div><label class="switch"><input id="dark-toggle" type="checkbox" ${state.theme===\'dark\'?\'checked\':\'\'}><span class="slider"></span></label></div></div>\n <div class="card premium-settings"><div><span class="pill">${state.plan===\'premium\'?\'PREMIUM\':\'FREE\'}</span><h3>Plan i reklamy</h3><p style="color:var(--muted)">${state.plan===\'premium\'?\'Premium aktywne — reklamy są wyłączone.\':\'W planie Free wyświetlane są reklamy. Premium będzie całkowicie je wyłączać.\'}</p></div><button class="secondary" data-route="premium">Zobacz Premium</button></div>\n <div class="card"><h3>Prywatność i reklamy</h3><div class="setting-row"><div><strong>Analityka</strong><small style="display:block;color:var(--muted)">Domyślnie wyłączona. W tej wersji nie wysyła danych do serwera.</small></div><label class="switch"><input id="analytics-toggle" type="checkbox" ${state.analytics?\'checked\':\'\'}><span class="slider"></span></label></div><div class="setting-row"><div><strong>AdMob w planie Free</strong><small style="display:block;color:var(--muted)">Baner jest ukrywany podczas aktywnego quizu i fiszek; interstitial może pojawić się dopiero po zakończeniu quizu. Build testowy używa oficjalnych reklam demonstracyjnych Google.</small></div><span class="badge">${hasNativeAds()?\'SDK GOTOWE\':\'WEB\'}</span></div>${adPrivacyOptionsRequired()?\'<button class="secondary" data-ad-privacy="1">Ustawienia prywatności reklam</button>\':\'<small style="display:block;color:var(--muted);margin-top:12px">Dodatkowy formularz ustawień prywatności nie jest obecnie wymagany dla tego urządzenia.</small>\'}</div>\n <div class="card"><h3>Treści medyczne</h3><p style="color:var(--muted)">Zweryfikowano ${VERIFIED_AT}. Dostępne lekcje mają źródła przypisane bezpośrednio pod treścią.</p><button class="secondary" data-route="sources">Bibliografia i źródła</button></div>\n <div class="card"><h3>Dane lokalne</h3><p style="color:var(--muted)">Reset usuwa postęp, historię błędów i harmonogram powtórek z tego urządzenia.</p><button class="ghost" data-reset="1">Wyczyść postęp</button></div>\n <div class="card"><h3>Informacje prawne</h3><p style="color:var(--muted)">Materiały są edukacyjne i nie zastępują decyzji klinicznych ani procedur placówki.</p><button class="link-btn" data-legal="privacy">Polityka prywatności – szkic</button><br><button class="link-btn" data-legal="terms">Regulamin – szkic</button></div></section>`;\n setTimeout(()=>{\n  document.querySelector(\'#dark-toggle\')?.addEventListener(\'change\',e=>setTheme(e.target.checked?\'dark\':\'light\'));\n  document.querySelector(\'#analytics-toggle\')?.addEventListener(\'change\',e=>{state.analytics=e.target.checked;save();toast(\'Zapisano ustawienie analityki\')});\n },0);\n syncNativeAds();\n}'
tx